# 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. 비워 두면 기본값으로 동작합니다.

# Claude API 키 (https://platform.claude.com). 없으면 상품 검색만 하는 오프라인 응대로 동작합니다.
ANTHROPIC_API_KEY=

# 사용할 모델과 응답 깊이. 응답이 느리거나 비용이 부담되면 claude-haiku-5-5 로 바꿔 보세요.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# offline 으로 두면 AI 없이 동작합니다.
AI_MODE=auto

# 관리 화면(/admin) PIN. 비워 두면 실행할 때마다 임시 PIN 이 콘솔에 표시됩니다.
ADMIN_PIN=

# 사장님 호출·결제 알림을 받을 주소. 예) https://ntfy.sh/남이-모르는-긴-토픽-이름
NOTIFY_URL=

# 결제 화면에 띄울 송금 QR 이미지. public/payment-qr.png 로 저장했다면 /payment-qr.png
PAYMENT_QR_URL=
# 결제 화면에 함께 보여줄 문구. 예) 토스 3333-00-0000000 홍길동
PAYMENT_NOTE=

PORT=8080
# 처음 실행할 때 복사해 올 업종 프리셋 (presets/ 아래 폴더 이름)
PRESET=vintage-shop
# 손님이 이 시간(초) 동안 조용하면 대화와 장바구니를 비웁니다.
SESSION_IDLE_SEC=180
